------- FILE main.asm
------- FILE modules/35_deluxe_rules.asm LEVEL 2 PASS 2
      0  d3b2					      include	"modules/35_deluxe_rules.asm"
      1  d3b2							; Eight Ball Champ Deluxe rules
      2  d3b2							; Address range: $D3B2-$DFFF (verified $FF padding in the canonical ROM)
      3  d3b2							;
      4  d3b2							; Existing handlers jump here so their surrounding addresses, animation data,
      5  d3b2							; service code, and hardware timing remain fixed. See ../../gamerules.md for
      6  d3b2							; the complete rule contract.
      7  d3b2
      8  d3b2				   DELUXE_PERIODIC_TICK
      9  d3b2							; C14E calls this in place of its original LDX $10B3. Preserve A, process the
     10  d3b2							; startup-music guard, spinner-collecting overlay and value-preview timers,
     11  d3b2							; then execute that displaced load last so C151 sees the same X value and
     12  d3b2							; condition codes as canonical.
     13  d3b2		       36		      PSHA
     14  d3b3		       7d 10 fc 	      TST	DELUXE_SPINNER_COLLECTING_ACTIVE
     15  d3b6		       27 1f		      BEQ	DELUXE_SPINNER_PREVIEW_TICK
     16  d3b8		       fe 11 17 	      LDX	DELUXE_SPINNER_COLLECTING_TIMER
     17  d3bb		       27 06		      BEQ	DELUXE_SPINNER_COLLECTING_EXPIRED
     18  d3bd		       09		      DEX
     19  d3be		       ff 11 17 	      STX	DELUXE_SPINNER_COLLECTING_TIMER
     20  d3c1		       26 14		      BNE	DELUXE_SPINNER_PREVIEW_TICK
     21  d3c3				   DELUXE_SPINNER_COLLECTING_EXPIRED
     22  d3c3		       bd de 86 	      JSR	DELUXE_CLEAR_SPINNER_COLLECTING
     23  d3c6							; Spinner collecting is independent of the current collect location. The first
     24  d3c6							; pulse already advanced that location to orbit inactive, and a new pool ball
     25  d3c6							; may since have activated the orbit. Expiration ends only the spinner scoring
     26  d3c6							; overlay and must not overwrite that newer location state. If another spinner
     27  d3c6							; stage has already become active, retain its newly displayed value lamps.
     28  d3c6		       b6 10 fb 	      LDAA	DELUXE_COLLECT_STATE
     29  d3c9		       84 07		      ANDA	#DELUXE_COLLECT_STATE_MASK
     30  d3cb		       81 06		      CMPA	#DELUXE_COLLECT_SPINNER+DELUXE_COLLECT_ACTIVE
     31  d3cd		       27 08		      BEQ	DELUXE_SPINNER_PREVIEW_TICK
     32  d3cf		       7f 10 b1 	      CLR	$10b1
     33  d3d2		       7f 10 b2 	      CLR	$10b2
     34  d3d5							; Keep the following routines at their established addresses.
     35  d3d5		       01 01		      dc.b	$01,$01
     36  d3d7				   DELUXE_SPINNER_PREVIEW_TICK
     37  d3d7							; A newly collected E-I-G-H-T letter starts this roughly 3.2-second lamp-only
     38  d3d7							; preview while the spinner collect is inactive. Bit 4 supplies a roughly
     39  d3d7							; half-second blink cycle, and the BF reload begins with a complete visible
     40  d3d7							; phase. Only 10B1 changes; DELUXE_COLLECT_STATE remains authoritative for
     41  d3d7							; scoring, so spinner pulses during the preview still take the unlit path.
     42  d3d7		       b6 11 14 	      LDAA	DELUXE_SPINNER_PREVIEW_TIMER
     43  d3da		       27 1a		      BEQ	DELUXE_ORBIT_PREVIEW_TICK
     44  d3dc		       4a		      DECA
     45  d3dd		       b7 11 14 	      STAA	DELUXE_SPINNER_PREVIEW_TIMER
     46  d3e0		       27 11		      BEQ	DELUXE_SPINNER_PREVIEW_FINISHED
     47  d3e2		       85 10		      BITA	#$10
     48  d3e4		       27 08		      BEQ	DELUXE_SPINNER_PREVIEW_HIDE
     49  d3e6		       b6 10 fe 	      LDAA	DELUXE_SPINNER_VALUE_MASK
     50  d3e9		       b7 10 b1 	      STAA	$10b1
     51  d3ec		       20 08		      BRA	DELUXE_ORBIT_PREVIEW_TICK
     52  d3ee				   DELUXE_SPINNER_PREVIEW_HIDE
     53  d3ee		       7f 10 b1 	      CLR	$10b1
     54  d3f1		       20 03		      BRA	DELUXE_ORBIT_PREVIEW_TICK
     55  d3f3				   DELUXE_SPINNER_PREVIEW_FINISHED
     56  d3f3		       7f 10 b1 	      CLR	$10b1
     57  d3f6				   DELUXE_ORBIT_PREVIEW_TICK
     58  d3f6							; A completed active right-orbit collect starts an independent preview of the
     59  d3f6							; newly advanced arrow value. Use the same duration and blink phase as the
     60  d3f6							; E-I-G-H-T spinner preview, but touch only 1044's orbit-value low nibble.
     61  d3f6							; The retained state at 10FF remains authoritative throughout the preview.
     62  d3f6		       b6 11 15 	      LDAA	DELUXE_ORBIT_PREVIEW_TIMER
     63  d3f9		       27 17		      BEQ	DELUXE_PERIODIC_AWARD_DISPLAY_TICK
     64  d3fb		       4a		      DECA
     65  d3fc		       b7 11 15 	      STAA	DELUXE_ORBIT_PREVIEW_TIMER
     66  d3ff		       27 0e		      BEQ	DELUXE_ORBIT_PREVIEW_FINISHED
     67  d401		       85 10		      BITA	#$10
     68  d403		       27 05		      BEQ	DELUXE_ORBIT_PREVIEW_HIDE
     69  d405		       bd d6 84 	      JSR	DELUXE_SHOW_ORBIT_PREVIEW_VALUE
     70  d408		       20 08		      BRA	DELUXE_PERIODIC_AWARD_DISPLAY_TICK
     71  d40a				   DELUXE_ORBIT_PREVIEW_HIDE
     72  d40a		       bd d6 7b 	      JSR	DELUXE_HIDE_ORBIT_PREVIEW_VALUE
     73  d40d		       20 03		      BRA	DELUXE_PERIODIC_AWARD_DISPLAY_TICK
     74  d40f				   DELUXE_ORBIT_PREVIEW_FINISHED
     75  d40f		       bd d6 7b 	      JSR	DELUXE_HIDE_ORBIT_PREVIEW_VALUE
     76  d412				   DELUXE_PERIODIC_AWARD_DISPLAY_TICK
     77  d412		       bd de 66 	      JSR	DELUXE_TICK_STARTUP_MUSIC_GUARD
     78  d415		       bd dc b4 	      JSR	DELUXE_TICK_CHAMP_SKILL_SHOT
     79  d418		       bd df 4d 	      JSR	DELUXE_PERIODIC_FINALIZE
     80  d41b				   DELUXE_PERIODIC_TICK_DONE
     81  d41b		       32		      PULA
     82  d41c		       fe 10 b3 	      LDX	$10b3
     83  d41f		       39		      RTS
     84  d420
     85  d420				   DELUXE_SELECT_PHASE_B_LAMP_OUTPUT
     86  d420							; E111 calls this from the timing-sensitive lamp-refresh interrupt instead of
     87  d420							; loading X with 1040 directly. Outside an active rack/B-A-L-L "more"
     88  d420							; indication, retain the original fast path. Otherwise copy the six Phase-B
     89  d420							; shadow bytes and change only the applicable bonus-lamp output bits. The
     90  d420							; skill shot also requires the copy path so its H/A/M blink can remain an
     91  d420							; output-only overlay on the authoritative C-H-A-M-P byte at 1040.
     92  d420		       b6 11 55 	      LDAA	DELUXE_CHAMP_SKILL_ACTIVE_TARGET
     93  d423		       26 11		      BNE	DELUXE_COPY_PHASE_B_LAMPS
