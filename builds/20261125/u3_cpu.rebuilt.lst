     16  c01d				   SWITCH_02_LEFT_THUMPER_HANDLER_ENTRY
     17  c01d		       d5 74		      dc.w	DELUXE_HANDLE_LEFT_THUMPER	; $C01D per-ball CHAMP value
     18  c01f				   SWITCH_01_RIGHT_THUMPER_HANDLER_ENTRY
     19  c01f		       d5 82		      dc.w	DELUXE_HANDLE_RIGHT_THUMPER	; $C01F per-ball CHAMP value
     20  c021		       c2 7d		      dc.b	$C2,$7D	; $C021 data/unclassified
     21  c023		       c9 57 c9 4c*	      dc.b	$C9,$57,$C9,$4C,$CB,$4F,$CB,$53,$F0,$6D,$F0,$79,$F0,$85,$CC,$4C	; $C023 data/unclassified
     22  c033		       cc 48 c2 7d*	      dc.b	$CC,$48,$C2,$7D,$CA,$D4,$CA,$D4,$CA,$D4,$CA,$D4,$CA,$D4,$CA,$3B	; $C033 data/unclassified
