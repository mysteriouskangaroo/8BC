------- FILE modules/60_service_tests.asm LEVEL 2 PASS 2
      0  ed40					      include	"modules/60_service_tests.asm"
      1  ed40							; Service tests
      2  ed40							; Address range: $ED40-$EFFF
      3  ed40							; Automatic solenoid-test sequencing, displayed test-number handling, and adjacent diagnostics.
      4  ed40							; Generated from the canonical Ghidra listing; later restructuring requires build and behavior validation.
      5  ed40
      6  ed40				   RUN_AUTOMATIC_SOLENOID_SELF_TEST
      7  ed40							; Automatic solenoid self-test. C0AA points to the selector bytes at C0BA. The loop displays sequential BCD test numbers while firing M0, M1, M2, M3, M4, M7, M8, M9, M10, M11, M13, and M14 as tests 01-12. After two FF table terminators, the continuous-output table contains BF; EDBA writes it directly to PIA1 port B as test 13, the K1 flipper-enable relay. This ROM sequence independently confirms manual page 1-18.
      8  ed40		       ce ef 26 	      LDX	#$ef26	; $ED40: $CE,$EF,$26
      9  ed43		       ff 10 17 	      STX	$1017	; $ED43: $FF,$10,$17
