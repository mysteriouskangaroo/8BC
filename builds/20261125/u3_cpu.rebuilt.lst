      2  cdd8							; Address range: $CDD8-$DFFF
      3  cdd8							; Pool-ball first-sink/5,000 handlers and the remaining high-level rule code before the interrupt region.
      4  cdd8							; Generated from the canonical Ghidra listing; later restructuring requires build and behavior validation.
      5  cdd8
      6  cdd8				   HANDLE_PAIRED_POOL_BALL_DROP_TARGET
      7  cdd8							; Paired pool-ball drop-target handler for switches 25 (balls 1/2) and 28
      8  cdd8							; (balls 4/5). Ignore a closure already latched in 10C5. Otherwise latch it,
      9  cdd8							; award the scaled 250 points (playfield value 2,500), and record the first
     10  cdd8							; unsunk ball
     11  cdd8							; bit in 10C3; only after both bits in the pair are set does a later rearmed
     12  cdd8							; hit take the scaled 500-point branch (original 5,000) at D034.
     13  cdd8		       c6 24		      LDAB	#$24	; $CDD8: $C6,$24
     14  cdda		       bd ca aa 	      JSR	QUEUE_SOUND_AND_CHECK_SCORE_GATE	; $CDDA: $BD,$CA,$AA
