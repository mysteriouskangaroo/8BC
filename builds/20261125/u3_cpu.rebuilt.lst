   2224  df85				   DELUXE_COLLECT_REPEATING_EXTRA_BALL
   2225  df85							; Reproduce CD2D-CD38's canonical Extra Ball collection: force the steady
   2226  df85							; Extra Ball lamp shadow off, show its award message, then enter the original
   2227  df85							; Extra Ball award path at C1E9. The qualifier bit is rebuilt below.
   2228  df85		       b6 10 c1 	      LDAA	$10c1
   2229  df88		       84 7f		      ANDA	#$7f
   2230  df8a		       b7 10 c1 	      STAA	$10c1
   2231  df8d		       b6 10 43 	      LDAA	HOLE_BONUS_LAMP_SHADOW
   2232  df90		       8a 80		      ORAA	#BALL_EXTRA_BALL_QUALIFIED_STATE
   2233  df92		       b7 10 43 	      STAA	HOLE_BONUS_LAMP_SHADOW
   2234  df95		       ce 16 e2 	      LDX	#$16e2
   2235  df98		       bd f6 c9 	      JSR	$f6c9
   2236  df9b		       bd c1 e9 	      JSR	$c1e9
   2237  df9e				   DELUXE_TEST_REPEATING_BALL_SPECIAL
   2238  df9e		       b6 11 4f 	      LDAA	DELUXE_BALL_LETTER_AWARD_PENDING
   2239  dfa1		       81 02		      CMPA	#$02
   2240  dfa3		       25 09		      BCS	DELUXE_UPDATE_REPEATING_BALL_QUALIFIERS
   2241  dfa5							; Reproduce the canonical E-I-G-H-T Special collection display and enter the
   2242  dfa5							; common Deluxe Special path, including sound, points, operator award, and
   2243  dfa5							; knocker. This is deliberately independent of the Extra Ball branch above.
   2244  dfa5		       ce 16 bf 	      LDX	#$16bf
   2245  dfa8		       bd f6 c9 	      JSR	$f6c9
   2246  dfab		       bd c1 d6 	      JSR	SPECIAL_COLLECT_WITH_SOUND
   2247  dfae				   DELUXE_UPDATE_REPEATING_BALL_QUALIFIERS
   2248  dfae							; The E-I-G-H-T Special is available for the next letter after B and remains
   2249  dfae							; available thereafter. Keep its base shadow off so $10BE bit 7 supplies the
   2250  dfae							; blink. Likewise, set the Extra Ball qualifier only when the *next* count has
   2251  dfae							; the parity selected by register 43.
   2252  dfae		       b6 10 3e 	      LDAA	$103e
   2253  dfb1		       8a 80		      ORAA	#$80
   2254  dfb3		       b7 10 3e 	      STAA	$103e
   2255  dfb6		       b6 10 be 	      LDAA	$10be
   2256  dfb9		       8a 80		      ORAA	#$80
   2257  dfbb		       b7 10 be 	      STAA	$10be
   2258  dfbe		       b6 10 43 	      LDAA	HOLE_BONUS_LAMP_SHADOW
   2259  dfc1		       8a 80		      ORAA	#BALL_EXTRA_BALL_QUALIFIED_STATE
   2260  dfc3		       b7 10 43 	      STAA	HOLE_BONUS_LAMP_SHADOW
   2261  dfc6		       b6 10 c1 	      LDAA	$10c1
   2262  dfc9		       84 7f		      ANDA	#$7f
   2263  dfcb		       b7 10 c1 	      STAA	$10c1
   2264  dfce		       b6 16 8b 	      LDAA	X_BALL_OPTION_PACKED_REGISTER
   2265  dfd1		       85 40		      BITA	#X_BALL_AT_B_SETTING_BIT
   2266  dfd3		       27 09		      BEQ	DELUXE_QUALIFY_NEXT_A_MODE_EXTRA_BALL
   2267  dfd5							; In B mode an even current count means the next, odd count awards Extra Ball.
   2268  dfd5		       b6 11 4f 	      LDAA	DELUXE_BALL_LETTER_AWARD_PENDING
   2269  dfd8		       85 01		      BITA	#$01
   2270  dfda		       27 09		      BEQ	DELUXE_QUALIFY_NEXT_EXTRA_BALL
   2271  dfdc		       20 0f		      BRA	DELUXE_BALL_LETTER_AWARDS_DONE
   2272  dfde				   DELUXE_QUALIFY_NEXT_A_MODE_EXTRA_BALL
   2273  dfde							; In A mode an odd current count means the next, even count awards Extra Ball.
   2274  dfde		       b6 11 4f 	      LDAA	DELUXE_BALL_LETTER_AWARD_PENDING
   2275  dfe1		       85 01		      BITA	#$01
   2276  dfe3		       27 08		      BEQ	DELUXE_BALL_LETTER_AWARDS_DONE
   2277  dfe5				   DELUXE_QUALIFY_NEXT_EXTRA_BALL
   2278  dfe5		       b6 10 c1 	      LDAA	$10c1
   2279  dfe8		       8a 80		      ORAA	#BALL_EXTRA_BALL_QUALIFIED_STATE
   2280  dfea		       b7 10 c1 	      STAA	$10c1
   2281  dfed				   DELUXE_BALL_LETTER_AWARDS_DONE
   2282  dfed		       7f 11 4f 	      CLR	DELUXE_BALL_LETTER_AWARD_PENDING
   2283  dff0		       7e cd 46 	      JMP	$cd46
   2284  dff3
   2285  dff3				   DELUXE_AWARD_SCALED_2500
   2286  dff3							; CC85 calls here for every E-I-G-H-T target hit. Pool-ball first sinks also
   2287  dff3							; tail-call here when they do not match the currently spoken ball. Apply
   2288  dff3							; Deluxe's global divide-by-ten score scale to the 2,500 playfield value: one
   2289  dff3							; multiplier-aware 50-point award plus two multiplier-aware 100-point units
   2290  dff3							; produces displayed scores of 250 / 500 / 750 at 1x / 2x / 3x. The later
   2291  dff3							; already-sunk pool-ball path remains at D034 and still drives the physical
   2292  dff3							; 5,000 lamp effect independently. This eight-byte helper was relocated into
   2293  dff3							; the remaining expansion space to preserve all established fixed addresses.
   2294  dff3		       bd c9 c4 	      JSR	AWARD_50_POINTS_WITH_PLAYFIELD_MULTIPLIER
   2295  dff6		       c6 02		      LDAB	#$02
   2296  dff8		       7e c9 f9 	      JMP	AWARD_B_HUNDRED_WITH_PLAYFIELD_MULTIPLIER
   2297  dffb
   2298  dffb				   DELUXE_RULES_END
   2299  dffb							; Preserve the canonical $FF fill up to the fixed interrupt module at $E000.
   2300  dffb		       ff ff ff ff*	      ds.b	$E000-DELUXE_RULES_END,$FF
