------- FILE modules/00_tables_lamps_sound.asm LEVEL 2 PASS 2
      0  c000					      include	"modules/00_tables_lamps_sound.asm"
      1  c000							; Low-ROM tables, lamp effects, and sound transport
      2  c000							; Address range: $C000-$C497
      3  c000							; Dispatch tables and early shared routines, including periodic lamp effects and controller-to-sound-board output.
      4  c000							; Generated from the canonical Ghidra listing; later restructuring requires build and behavior validation.
      5  c000
      6  c000				   ROM_ADDITIVE_CHECKSUM_COMPENSATION_BYTE
      7  c000							; Startup at E3DB-E40D sums all 16 KiB and requires an 8-bit result of FF.
      8  c000							; build.ps1 generates this byte in a first pass, then reassembles and verifies it.
      9  c000		       11		      dc.b	ROM_ADDITIVE_CHECKSUM_COMPENSATION_VALUE	; $C000 generated checksum compensation
     10  c001		       42 33 38 2d*	      dc.b	$42,$33,$38,$2D,$38,$30,$33,$2D,$30,$35,$20,$55,$33,$40,$00	; $C001 ROM identifier and checksum metadata
     11  c010		       00		      dc.b	$00	; $C010 data/unclassified
     12  c011				   PLAYFIELD_SWITCH_HANDLER_TABLE
     13  c011		       f8 a8		      dc.b	$F8,$A8	; $C011 data/unclassified
     14  c013				   SWITCH_07_REBOUND_HANDLER_ENTRY
